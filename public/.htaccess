<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <If "%{REQUEST_URI} =~ m#^/assets/optimized/#">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/integration/#">
    Header always set X-Robots-Tag "noindex"
  </If>
</IfModule>
ErrorDocument 404 /404.html

# The Resend config sits next to contact.php on hosts without access above public_html.
<Files "ilvincino-config.php">
  Require all denied
</Files>
